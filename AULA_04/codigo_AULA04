import numpy as np
import pandas as pd
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.neighbors import KNeighborsClassifier
from sklearn.pipeline import Pipeline
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, f1_score
from sklearn.model_selection import train_test_split

# 1. Carregar dataset do CSV
df = pd.read_csv('dataset_moveis_100.csv')

# 2. Divisão Treino e Teste
X_train, X_test, y_train, y_test = train_test_split(
    df['texto'], df['intencao'], test_size=0.50, random_state=42, stratify=df['intencao']
)

# TODO 1: Monte a Pipeline utilizando TfidfVectorizer e KNeighborsClassifier(n_neighbors=3, metric='cosine')
# pipeline_knn = Pipeline([
#     ('vectorizer', ...),
#     ('classifier', ...)
# ])
pipeline_knn = Pipeline([
    ('vectorizer', TfidfVectorizer(ngram_range=(1, 2))),
    ('classifier', KNeighborsClassifier(n_neighbors=3, metric='cosine'))
])

# TODO 2: Treine a pipeline com os dados de treino (X_train, y_train)
# pipeline_knn.fit(...)

pipeline_knn.fit(X_train, y_train)


# TODO 3: Gere as predicoes nos dados de teste e exiba o classification_report e a confusion_matrix
y_pred = pipeline_knn.predict(X_test)

acc = accuracy_score(y_test, y_pred)
f1 = f1_score(y_test, y_pred, average='weighted')

print("Accuracy:", acc)
print("F1 Score:", f1)

print("\nClassification Report:")
print(classification_report(y_test, y_pred))

print("\nConfusion Matrix:")
print(confusion_matrix(y_test, y_pred))


LIMIAR_CONFIANCA = 0.50


# TODO 5: Extraia as probabilidades e a classe prevista usando predict_proba e predict
def processar_mensagem(texto):
    # 1. Obtenção das probabilidades do modelo treinado
    probs = pipeline_knn.predict_proba([texto])[0]
    maior_prob = np.max(probs)
    intencao = pipeline_knn.predict([texto])[0]

    
    # TODO 6: Aplique a regra de decisao:
    # Se maior_prob >= LIMIAR_CONFIANCA: imprima a intencao e a probabilidade.
    # Senao: imprima o Fallback encaminhando para atendimento humano.
    if maior_prob >= LIMIAR_CONFIANCA:
        print(f"\nBot [Intenção: {intencao.upper()} | Confiança: {maior_prob*100:.1f}%]: ", end="")
        
        if intencao == "vendas":
            print("Posso ajudar com a compra de móveis. Qual produto você deseja comprar?")
            
        elif intencao == "suporte":
            print("Claro! Posso ajudar com montagem, manuais e assistência. Qual é o problema?")
            
        elif intencao == "trocas_devolucoes":
            print("Posso ajudar com trocas e devoluções. Qual produto você deseja trocar ou devolver?")
            
        elif intencao == "reclamacoes":
            print("Lamento pelo ocorrido. Vou registrar sua reclamação. Pode me contar mais detalhes?")
            
        elif intencao == "logistica_entregas":
            print("Posso ajudar a consultar sua entrega. Você tem o número do pedido ou código de rastreamento?")
            
        else:
            print("Entendi sua solicitação. Como posso ajudar?")
            
    else:
        # Fallback ativo encaminhando para atendente humano
        print(f"\nBot: [FALLBACK - Confiança baixa: {maior_prob*100:.1f}%]")
        print("Desculpe, não consegui entender sua solicitação. Por favor, aguarde um momento enquanto encaminho você para um atendente humano...")


print("\n=== INICIANDO BATERIA DE TESTES (10 INPUTS OBRIGATÓRIOS) ===")

for i in range(1, 11):
    print(f"\n[Teste {i}/10]")
    
    # TODO 4: Solicite a frase do usuario via teclado
    frase = input("Digite a frase do cliente: ").strip()
    
    # Permite encerrar a bateria de testes
    if frase.lower() == "sair":
